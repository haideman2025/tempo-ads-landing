# Biến môi trường cho landing TEMPO. Copy sang .env rồi điền giá trị thật.
# .env đã nằm trong .gitignore — không commit giá trị thật.

# --- Client (Vite inject vào client/index.html lúc build) ---
# Thiếu VITE_META_PIXEL_ID thì bản build không có Pixel và test metaPixel.config sẽ đỏ.
VITE_META_PIXEL_ID=1955804598438163
VITE_ANALYTICS_ENDPOINT=https://manus-analytics.com
VITE_ANALYTICS_WEBSITE_ID=6274be27-12f9-4a94-98f3-bb010864e74f

# --- Server ---
DATABASE_URL=mysql://user:password@host:3306/database
JWT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Meta Conversions API — dùng để báo Purchase khi đơn COD đã giao thành công.
# Lấy tại Events Manager > dataset 1955804598438163 > Settings > Generate access token.
# Thiếu token thì markDelivered vẫn cập nhật đơn bình thường, chỉ bỏ qua bước báo Meta.
# Kiểm chứng bằng: npx tsx scripts/verify-capi.ts <TEST_EVENT_CODE>
META_CAPI_ACCESS_TOKEN=
